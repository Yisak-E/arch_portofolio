# Copy this file to .env.local and fill in the values from
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL of the site (used for sign-in redirects). Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: email the owner when a new message arrives (https://resend.com)
RESEND_API_KEY=
OWNER_NOTIFY_EMAIL=
NOTIFY_FROM_EMAIL=Portfolio <onboarding@resend.dev>
